
{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "A startup application or pitch sent by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "country": { "type": "string" },
        "age": { "type": "string" },
        "idea": { "type": "string" },
        "role": { "type": "string" },
        "tagline": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "accepted"] }
      },
      "required": ["name", "email", "idea", "timestamp"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/applications/{applicationId}": {
      "schema": "Application",
      "description": "Stored startup applications and pitches."
    }
  }
}
